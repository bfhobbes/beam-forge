{
  "name": "beam-forge-simulator",
  "version": "0.2.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "vp lint && eslint src",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test --run",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "verify": "npm run check && npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@lucide/svelte": "^1.65.0",
    "@shadcn/lint": "^0.2.3",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24",
    "bits-ui": "^2.20.2",
    "cn": "^0.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.6.0",
    "shadcn-svelte": "^1.7.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.10.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": "^24.11.0"
  }
}
