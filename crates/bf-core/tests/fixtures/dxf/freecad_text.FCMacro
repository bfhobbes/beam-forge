# Writes freecad_text.dxf: Draft texts exported by FreeCAD's own DXF
# exporter (the Python "legacy" one; FreeCAD's C++ exporter leaves Draft
# texts out). Run in the FreeCAD GUI, which the exporter needs for font
# sizes and justification:
#
#   set BF_OUT=<dir for the .dxf>
#   set BF_DXFLIB=<dir holding dxfLibrary.py>
#   freecad.exe freecad_text.FCMacro
#
# dxfLibrary.py is the library FreeCAD itself downloads for the legacy
# exporter, from github.com/yorikvanhavre/Draft-dxf-importer. Generated
# with FreeCAD 1.1.3 on Windows.

import os
import sys
import traceback

out = os.environ["BF_OUT"]
sys.path.insert(0, os.environ["BF_DXFLIB"])
log = open(os.path.join(out, "freecad_text.log"), "w")
try:
    import FreeCAD as App
    import Draft
    import importDXF

    # Use the legacy exporter without touching the user's preferences.
    read_preferences = importDXF.readPreferences

    def legacy():
        read_preferences()
        importDXF.dxfUseLegacyExporter = True

    importDXF.readPreferences = legacy

    doc = App.newDocument("TextSample")
    frame = Draft.make_wire(
        [App.Vector(0, 0, 0), App.Vector(100, 0, 0), App.Vector(100, 50, 0), App.Vector(0, 50, 0)],
        closed=True,
    )
    objects = [frame]
    # (justification, text, placement, font size)
    for justification, text, placement, size in [
        ("Left", ["Beam Forge"], App.Placement(App.Vector(10, 30, 0), App.Rotation()), 5.0),
        ("Center", ["Centre"], App.Placement(App.Vector(50, 10, 0), App.Rotation()), 4.0),
        ("Right", ["Right"], App.Placement(App.Vector(95, 40, 0), App.Rotation()), 3.0),
        (
            "Left",
            ["Up"],
            App.Placement(App.Vector(90, 5, 0), App.Rotation(App.Vector(0, 0, 1), 90)),
            6.0,
        ),
    ]:
        label = Draft.make_text(text, placement)
        label.ViewObject.FontSize = size
        label.ViewObject.Justification = justification
        objects.append(label)
    doc.recompute()
    importDXF.export(objects, os.path.join(out, "freecad_text.dxf"))
    for o in objects:
        log.write("%s %s\n" % (o.Name, o.Placement))
    log.write("ok\n")
except Exception:
    log.write(traceback.format_exc())
log.close()
os._exit(0)
