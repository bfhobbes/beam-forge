{
  "name": "beam-forge",
  "version": "0.2.4",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "simulator"
  ],
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vp -C . dev",
    "build": "vp -C . build",
    "preview": "vp -C . preview",
    "prepare": "svelte-kit sync || echo \"\"",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp lint && eslint src",
    "lint:design:proof": "node scripts/prove-design-lint.mjs",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "test": "vp test --run",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "bindings": "cargo test --workspace export_bindings",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run sim:stage && tauri build --config src-tauri/tauri.bundle.conf.json",
    "sim:dev": "npm run desktop:dev -w simulator",
    "release:build": "npm run sim:stage && tauri build --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.release.conf.json",
    "release:version": "node scripts/release-version.mjs",
    "sim:build": "npm run desktop:build -w simulator",
    "sim:stage": "node scripts/stage-simulator.mjs",
    "sim:verify": "npm run verify -w simulator",
    "verify": "npm run check && npm run lint && npm run format:check && npm run lint:design:proof && npm run test:updates:service && npm run test:release:manifest && npm test && npm run build",
    "updates:setup": "node scripts/updates.mjs setup",
    "updates:dev": "node scripts/updates.mjs dev",
    "updates:build": "node scripts/updates.mjs build",
    "updates:publish": "node scripts/updates.mjs publish",
    "updates:serve": "node scripts/update-server.mjs",
    "test:updates:service": "node --test scripts/update-server.test.mjs",
    "test:release:manifest": "node --test scripts/release-manifest.test.mjs",
    "smoke:web": "node scripts/smoke-web.mjs",
    "test:smoke:web": "node --test scripts/smoke-web.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.65.0",
    "@shadcn/lint": "^0.2.3",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24",
    "@types/rbush": "^4.0.0",
    "@types/semver": "^7.8.0",
    "bits-ui": "^2.20.2",
    "cn": "^0.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.6.0",
    "paneforge": "^1.0.2",
    "playwright-core": "^1.65.1",
    "rbush": "^4.0.1",
    "semver": "^7.8.5",
    "shadcn-svelte": "^1.7.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.10.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "engines": {
    "node": "^24.11.0"
  },
  "packageManager": "npm@11.12.1"
}
